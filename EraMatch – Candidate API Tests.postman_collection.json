    {
      "name": "4 – Assessment Flow",
      "item": [
        {
          "name": "Get Assessment Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Assessment config may 404 if candidate's pipeline has no assessment stage",
                  "pm.test('Returns 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Has assessment_id', () => pm.expect(json).to.have.property('assessment_id'));",
                  "  pm.test('Has duration_minutes', () => {",
                  "    pm.expect(json).to.have.property('duration_minutes');",
                  "    pm.expect(json.duration_minutes).to.be.a('number').and.to.be.above(0);",
                  "  });",
                  "  pm.test('Has sections array', () => {",
                  "    pm.expect(json).to.have.property('sections');",
                  "    pm.expect(json.sections).to.be.an('array').with.length.greaterThan(0);",
                  "  });",
                  "  pm.environment.set('assessment_id', json.assessment_id);",
                  "  if (json.stage_id) pm.environment.set('stage_id', json.stage_id);",
                  "  pm.environment.set('assessment_available', 'true');",
                  "} else {",
                  "  pm.environment.set('assessment_available', 'false');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/assessment/config",
              "host": ["{{base_url}}"],
              "path": ["assessment", "config"]
            }
          },
          "response": []
        },
        {
          "name": "Start Assessment Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('assessment_available') !== 'true') { pm.test.skip('No assessment in pipeline'); return; }",
                  "pm.test('Status 200 or 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Has session_id', () => {",
                  "    pm.expect(json).to.have.property('session_id');",
                  "    pm.expect(json.session_id).to.be.a('string').with.length.greaterThan(10);",
                  "  });",
                  "  pm.test('Has questions array', () => {",
                  "    pm.expect(json).to.have.property('questions');",
                  "    pm.expect(json.questions).to.be.an('array').with.length.greaterThan(0);",
                  "  });",
                  "  pm.test('Has duration_minutes', () => pm.expect(json).to.have.property('duration_minutes'));",
                  "  pm.test('Has started_at', () => pm.expect(json).to.have.property('started_at'));",
                  "  pm.test('Each question has required fields', () => {",
                  "    const q = json.questions[0];",
                  "    pm.expect(q).to.have.property('question_id');",
                  "    pm.expect(q).to.have.property('question_type');",
                  "    pm.expect(q).to.have.property('question_text');",
                  "    pm.expect(q).to.have.property('points');",
                  "  });",
                  "  pm.environment.set('session_id', json.session_id);",
                  "  const mcqQ = json.questions.find(q => q.question_type === 'mcq');",
                  "  const essayQ = json.questions.find(q => q.question_type === 'essay');",
                  "  const codingQ = json.questions.find(q => q.question_type === 'coding');",
                  "  if (mcqQ) {",
                  "    pm.environment.set('mcq_question_id', mcqQ.question_id);",
                  "    const optionCount = mcqQ.question_config && mcqQ.question_config.options ? mcqQ.question_config.options.length : 4;",
                  "    pm.environment.set('mcq_option_count', optionCount);",
                  "  }",
                  "  if (essayQ) pm.environment.set('essay_question_id', essayQ.question_id);",
                  "  if (codingQ) {",
                  "    pm.environment.set('coding_question_id', codingQ.question_id);",
                  "    pm.environment.set('coding_language', codingQ.question_config && codingQ.question_config.language ? codingQ.question_config.language : 'python');",
                  "  }",
                  "  pm.environment.set('total_questions', json.questions.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"assessment_id\":\"{{assessment_id}}\",\"stage_id\":\"{{stage_id}}\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/assessment/start",
              "host": ["{{base_url}}"],
              "path": ["assessment", "start"]
            },
            "description": "Start or resume session. Chains session_id, mcq_question_id, essay_question_id, coding_question_id."
          },
          "response": []
        },
        {
          "name": "Save MCQ Answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sessionId = pm.environment.get('session_id');",
                  "if (!sessionId) { pm.test.skip('No active assessment session — skipping'); return; }",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has answer_id', () => pm.expect(json).to.have.property('answer_id'));",
                  "pm.test('MCQ is auto-graded', () => {",
                  "  pm.expect(json).to.have.property('is_correct');",
                  "  pm.expect(json.is_correct).to.be.a('boolean');",
                  "});",
                  "pm.test('Has points_earned', () => {",
                  "  pm.expect(json).to.have.property('points_earned');",
                  "  pm.expect(json.points_earned).to.be.a('number');",
                  "});",
                  "pm.test('Has message', () => pm.expect(json).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{session_id}}\",\"question_id\":\"{{mcq_question_id}}\",\"answer_data\":{\"selected_option\":0},\"time_spent_seconds\":15}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/assessment/answer",
              "host": ["{{base_url}}"],
              "path": ["assessment", "answer"]
            },
            "description": "Save MCQ answer using dynamically extracted mcq_question_id from Start Session."
          },
          "response": []
        },
        {
          "name": "Save Essay Answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const essayId = pm.environment.get('essay_question_id');",
                  "if (!essayId) { pm.test.skip('No essay question in this assessment'); return; }",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has answer_id', () => pm.expect(json).to.have.property('answer_id'));",
                  "pm.test('Essay not auto-graded (null is_correct)', () => {",
                  "  pm.expect(json.is_correct).to.be.null;",
                  "});",
                  "pm.test('Has message', () => pm.expect(json).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{session_id}}\",\"question_id\":\"{{essay_question_id}}\",\"answer_data\":{\"text\":\"REST is a stateless architecture using HTTP methods for CRUD operations on resources identified by URIs. GraphQL is a query language that allows clients to request exactly the data they need from a single endpoint, reducing over-fetching. REST is simpler for basic CRUD while GraphQL offers more flexibility for complex data requirements.\"},\"time_spent_seconds\":120}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/assessment/answer",
              "host": ["{{base_url}}"],
              "path": ["assessment", "answer"]
            },
            "description": "Save essay answer using dynamically extracted essay_question_id. Essay is NOT auto-graded at save time."
          },
          "response": []
        },
        {
          "name": "Run Code & Tests (Trial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const codingId = pm.environment.get('coding_question_id');",
                  "if (!codingId) { pm.test.skip('No coding question in this assessment'); return; }",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has status field', () => {",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.a('string');",
                  "});",
                  "pm.test('Has stdout', () => pm.expect(json).to.have.property('stdout'));",
                  "pm.test('Has stderr', () => pm.expect(json).to.have.property('stderr'));",
                  "pm.test('Status is valid execution result', () => {",
                  "  pm.expect(json.status).to.be.oneOf(['Accepted', 'Runtime Error', 'Time Limit Exceeded']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{session_id}}\",\"question_id\":\"{{coding_question_id}}\",\"code\":\"def solution(n):\\n    return n * 2\",\"language\":\"python\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/assessment/run-code",
              "host": ["{{base_url}}"],
              "path": ["assessment", "run-code"]
            },
            "description": "Run code against all test cases. Counts as one trial attempt."
          },
          "response": []
        },
        {
          "name": "Save Answer – Invalid Session (expect 4xx)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid session returns 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 404, 422]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
