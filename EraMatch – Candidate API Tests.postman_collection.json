        {
          "name": "Get Assessments / Stages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response is array of stages', () => {",
                  "  pm.expect(json).to.be.an('array');",
                  "});",
                  "// Save stage info for assessment start",
                  "const stages = Array.isArray(json) ? json : (json.stages || []);",
                  "if (stages.length > 0) {",
                  "  const techStage = stages.find(s => s.type === 'technical_assessment' || s.type === 'assessment');",
                  "  if (techStage) {",
                  "    pm.environment.set('stage_id', techStage.stage_id || techStage.id);",
                  "    if (techStage.assessment_id) pm.environment.set('assessment_id', techStage.assessment_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/candidate/assessments",
              "host": ["{{base_url}}"],
              "path": ["candidate", "assessments"]
            }
          },
          "response": []
        }
