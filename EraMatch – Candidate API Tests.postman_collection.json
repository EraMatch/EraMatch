    "name": "EraMatch – Candidate API Tests",
    "description": "Automated API test suite for the EraMatch Candidate Portal.\nCovers: Authentication, Dashboard, Assessment (start → answer → run-code → submit), Video Interview, AI Service, Monitoring, and Security.\n\nRun with Newman:\n  newman run \"EraMatch – Candidate API Tests.postman_collection.json\" -e \"EraMatch Local.postman_environment.json\"\n\nDB: PostgreSQL 17.6.1 on Supabase (eu-west-1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 – Auth",
      "item": [
        {
          "name": "Valid Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has access_token (JWT)', () => {",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.expect(json.access_token.split('.').length).to.equal(3);",
                  "});",
                  "pm.test('Has refresh_token', () => pm.expect(json).to.have.property('refresh_token'));",
                  "// Chain: save tokens for all subsequent requests",
                  "pm.environment.set('access_token', json.access_token);",
                  "pm.environment.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{candidate_email}}\",\"password\":\"{{candidate_password}}\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/candidate/login",
              "host": ["{{base_url}}"],
              "path": ["candidate", "login"]
            },
            "description": "Login with valid credentials. Chains access_token, refresh_token, candidate_id."
          },
          "response": []
        },
        {
          "name": "Wrong Password (expect 4xx)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Wrong password returns 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 422]));",
                  "pm.test('No token leaked', () => pm.expect(pm.response.json()).to.not.have.property('access_token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
