# Database
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Security
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# GitHub (used by background GitHub analysis jobs)
GITHUB_TOKEN=

# AI/LLM Providers (set at least one)
# Ollama Cloud - https://ollama.com/blog/cloud-models
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq - https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default providers: "ollama", "gemini", "groq", "openai"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_PROVIDER=gemini

# =========================================================================
# Live Interview V2 — LiveKit Cloud
# Get from https://cloud.livekit.io
# =========================================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =========================================================================
# Live Interview V2 — Role-based LLM Providers (primary/secondary/tertiary)
# Each role can use: gemini, ollama, groq, openai
# =========================================================================
INTERVIEWER_PRIMARY_PROVIDER=gemini
INTERVIEWER_PRIMARY_MODEL=gemini-2.5-flash-lite
INTERVIEWER_SECONDARY_PROVIDER=
INTERVIEWER_SECONDARY_MODEL=

JUDGE_PRIMARY_PROVIDER=gemini
JUDGE_PRIMARY_MODEL=gemini-2.5-pro
JUDGE_SECONDARY_PROVIDER=
JUDGE_SECONDARY_MODEL=

HELPER_PRIMARY_PROVIDER=gemini
HELPER_PRIMARY_MODEL=gemini-2.5-flash-lite

RUBRIC_BUILDER_PRIMARY_PROVIDER=gemini
RUBRIC_BUILDER_PRIMARY_MODEL=gemini-2.5-pro

# =========================================================================
# Live Interview V2 — TTS / STT Providers
# =========================================================================
TTS_PRIMARY_PROVIDER=google_tts
TTS_PRIMARY_VOICE=en-US-Wavenet-D
TTS_SECONDARY_PROVIDER=elevenlabs
TTS_SECONDARY_VOICE=Rachel

STT_PRIMARY_PROVIDER=google_stt
STT_PRIMARY_MODEL=chirp_2
STT_SECONDARY_PROVIDER=faster_whisper_local
STT_SECONDARY_MODEL=distil-large-v3

# =========================================================================
# Live Interview V2 — External API Keys
# =========================================================================
GOOGLE_APPLICATION_CREDENTIALS=        # Path to GCP service account JSON
ELEVEN_API_KEY=                        # ElevenLabs TTS

