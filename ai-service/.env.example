# AI Service Environment
DEBUG=true
USE_MOCK=true

# Ollama Cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=deepseek-v3.1:671b-cloud
