# =============================================================================
# EraMatch AI Service — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env with secrets.
# =============================================================================

# === General ===
DEBUG=true
USE_MOCK=false
HOST=0.0.0.0
PORT=8001
PYTHONPATH=.

# === Ollama Configuration (Primary LLM) ===
# OLLAMA_HOST: Base URL for native Ollama SDK (used by services/ollama.py)
OLLAMA_HOST=http://localhost:11434
# OLLAMA_BASE_URL: OpenAI-compatible API endpoint (used by interviewer_agent coverage checker)
OLLAMA_BASE_URL=http://localhost:11434
# No API key needed when using local Ollama proxy — cloud auth is handled by `ollama signin`
OLLAMA_API_KEY=
# Default model name for non-interview tasks
OLLAMA_MODEL=gemma3

# === Live Interview V2 — LLM Model Config ===
# Primary LLM for interviewer (Ollama cloud model via local proxy).
# deepseek-v4-flash:cloud is fastest (~1s). gemma3:12b-cloud is the reliable fallback.
INTERVIEWER_PRIMARY_MODEL=deepseek-v4-flash:cloud
# Secondary LLM — used if primary fails availability check at session start
INTERVIEWER_SECONDARY_MODEL=gemma3:12b-cloud
# Suppress reasoning leakage on thinking models (deepseek/minimax/gemini-flash).
# "none" = no thinking; without it those models waste the token budget and the AI
# returns empty/truncated speech. gemma3 (non-reasoning) safely ignores this.
INTERVIEWER_REASONING_EFFORT=none
# Coverage checker model (fast, cheap)
COVERAGE_CHECK_MODEL=gemma3:4b-cloud
# Fallback judge model (used if Gemini judge fails)
FALLBACK_JUDGE_MODEL=gemma3:4b-cloud

# === Question Import ===
OLLAMA_QUESTION_IMPORT_MODEL=gemma3:12b-cloud

# === Backend Communication ===
BACKEND_URL=http://localhost:8000

# === LiveKit Cloud (Real-time Video/Audio) ===
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# === Google Cloud (Gemini API + Cloud STT/TTS) ===
# API key for Gemini (used by livekit.plugins.google.LLM)
GOOGLE_API_KEY=your-google-api-key
# Service account JSON for Cloud STT (chirp_2) and Cloud TTS (Wavenet-D)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# === TTS / STT Voices ===
TTS_PRIMARY_VOICE=en-US-Wavenet-D
STT_PRIMARY_MODEL=chirp_2

# === Whisper (Local STT Fallback) ===
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# === HuggingFace (Optional) ===
HUGGINGFACE_TOKEN=
MODELS_DIR=./models

# === GitHub API (Optional — avoids rate limits on import) ===
GITHUB_TOKEN=

# === Database ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eramatch

# === ElevenLabs TTS (Optional Fallback) ===
ELEVEN_API_KEY=

# === Jina AI — Semantic Search Embeddings (https://jina.ai/embeddings/) ===
JINA_API_KEY=
